{
  "name": "omp-wechat-ask-notifier",
  "version": "0.3.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "OMP 等待回答时，通过 QQ 我的手机与微信文件传输助手发送问题与全部选项提醒",
  "type": "module",
  "files": ["dist", "bridge/*.py", "bridge/requirements.txt", "native", "runtime", "licenses", "scripts/prepare-runtime.mjs", "scripts/build-qq-native.ps1", "准备提醒.cmd", "README.md"],
  "ompDesktop": {
    "apiVersion": 1,
    "id": "wechat-ask-notifier",
    "owner": "daemon",
    "entries": { "client": "./dist/client.mjs", "service": "./dist/service.mjs" },
    "capabilities": ["agents.events"]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:qq-native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-qq-native.ps1",
    "build:wechat-native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/engine/build.ps1 -OutDir native/runtime",
    "prepare:wechat": "node scripts/prepare-runtime.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide-react": "1.72.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@omp-desktop/plugin": "0.7.1",
    "react": "19.1.0",
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": { "@omp-desktop/plugin": { "optional": true } },
  "engines": { "node": ">=22.5.0" }
}
