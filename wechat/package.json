{
  "name": "@omp-desktop/plugin-wechat",
  "version": "0.1.0",
  "description": "OMP Desktop 微信会话连接",
  "type": "module",
  "files": ["dist", "src", "bridge", "native/runtime", "native/engine/bridge.cpp", "native/engine/profiles.json", "native/engine/build.ps1"],
  "ompDesktop": {
    "apiVersion": 1,
    "id": "wechat",
    "owner": "daemon",
    "entries": { "client": "./dist/client.mjs", "service": "./dist/service.mjs" },
    "capabilities": ["agents.events"]
  },
  "scripts": { "build": "node build.mjs", "test": "node --test tests/*.test.mjs tests/*.test.cjs" },
  "peerDependencies": { "@omp-desktop/plugin": "0.7.0", "@omp-desktop/client": "0.7.0", "@omp-desktop/protocol": "0.7.0", "react": "19.1.0", "zod": "^4.4.3" },
  "devDependencies": { "esbuild": "0.28.2", "react": "19.1.0", "zod": "4.4.3" },
  "engines": { "node": ">=22.5.0" }
}
